    "tsx": "^4.23.15",
    "typescript": "~5.9.3"
  },
  "allowScripts": {
    "esbuild@0.26.0": true,
    "lmdb@3.4.3": true,
    "puppeteer@25.13.0": true,
    "msgpackr-extract@3.0.3": true,
