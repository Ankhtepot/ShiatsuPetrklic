    "@angular/router": "^21.0.8",
    "@emailjs/browser": "^4.4.1",
    "bootstrap": "^5.3.6",
    "bootstrap-icons": "^1.13.1",
    "ngx-markdown": "^21.3.0",
    "prismjs": "^1.30.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "vite": "^7.3.3"
  },
  "devDependencies": {
    "@angular/build": "^21.0.5",
    "@angular/cli": "^21.0.5",
    "@angular/compiler-cli": "^21.0.8",
    "@types/jasmine": "~5.1.0",
    "angular-cli-ghpages": "^3.1.1",
    "chokidar": "^4.0.3",
